}s;
int main()
{
int opt,i,tno;
FILE *fH; 
printf("\nEnter your name:");
scanf(" %[^\n]",s.name);
printf("\nEnter your age:");
scanf("%d",&s.age);
if(s.age<18)
{
printf("\nFor legal verifications, kindly provide us your identity details.........");
printf("\nEnter your EMIS number:");
scanf("%s",s.emis);
}
else
{
printf("\nDo you have a PAN card?...(y/n)");
scanf(" %c",&s.ch);
if(s.ch=='y')
{
printf("\nEnter your permanent account number(must be a 10 digit alphanumeric):");
scanf("%s",s.pan);
}
}
printf("\nEnter your phoneno:");
scanf("%s",s.phoneno);
printf("\nEnter your doorno:");
scanf(" %[^\n]",s.a.dno);
printf("\nEnter your street name:");
scanf(" %[^\n]",s.a.street);
printf("\nEnter your city name:");
scanf("%s",s.a.city);
printf("\nEnter your city's pincode:");
scanf("%ld",&s.a.pincode);
printf("\nEnter your deposit:");
scanf("%ld",&s.deposit);
s.new_balance=s.deposit;
do
{
printf("\n\tBANK ACCOUNT MANAGEMENT");
printf("\n1.Account creation\n2.Account Monitoring\n3.Commit");
printf("\nChoose an option:");
scanf("%d",&opt);
switch(opt)
{
case 1:
fH=fopen("Bank_Account.txt","w");
if(fH==NULL)
{
printf("\nerror in opening file");
