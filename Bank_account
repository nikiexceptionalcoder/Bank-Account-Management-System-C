#include <stdio.h>
#include <stdlib.h>
struct accountdetails
{
int actno;
int i,tno;
char name[25];
char phoneno[12];
int age;
char emis[30];
char ch;
char pan[12];
char tdate[20];
char description[40];
long new_balance;
struct address
{
char dno[5];
char street[40];
char city[35];
