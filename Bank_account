case 2:
fH=fopen("Bank_Account.txt","a");
if(fH==NULL)
{
printf("\nerror in opening file");
break;
}
printf("\nEnter the statement issued date:");
scanf("%s",s.statementdate);
fputs("\n\t~~~Bank Statement~~~",fH); 
fputs("\n...........................",fH); 
fputs("\nBank Name:@ Bank",fH); 
